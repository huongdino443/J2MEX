<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>
    <uses-feature android:glEsVersion="0x00020000" android:required="false"/>
    <application android:label="J2MEX" android:icon="@mipmap/ic_launcher"
        android:theme="@style/J2MEXTheme"
        android:allowNativeHeapPointerTagging="false"
        android:allowBackup="false" android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true" android:usesCleartextTraffic="true">
        <receiver android:name=".AppPreferencesReceiver" android:exported="false">
            <intent-filter>
                <action android:name="org.recompile.freej2me.lite.RUNTIME_SETTINGS_CHANGED"/>
            </intent-filter>
        </receiver>
        <provider
            android:name=".UpdateApkProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true"/>
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/java-archive"/>
                <data android:mimeType="application/x-java-archive"/>
                <data android:mimeType="application/x-jar"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/x-zip"/>
                <data android:mimeType="application/x-zip-compressed"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
        <activity android:name=".SessionOverviewActivity" android:exported="false"
            android:windowSoftInputMode="adjustNothing"/>
        <activity android:name=".RuntimeActivity" android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.runtime1"
            android:excludeFromRecents="true"
            android:process=":runtime"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".RuntimeLandscapeActivity" android:exported="false"
            android:taskAffinity="${applicationId}.runtime1"
            android:excludeFromRecents="true"
            android:process=":runtime"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".RuntimePortraitActivity" android:exported="false"
            android:taskAffinity="${applicationId}.runtime1"
            android:excludeFromRecents="true"
            android:process=":runtime"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".RuntimeSecondActivity" android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.runtime2"
            android:excludeFromRecents="true"
            android:process=":runtime2"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".RuntimeSecondLandscapeActivity" android:exported="false"
            android:taskAffinity="${applicationId}.runtime2"
            android:excludeFromRecents="true"
            android:process=":runtime2"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".RuntimeSecondPortraitActivity" android:exported="false"
            android:taskAffinity="${applicationId}.runtime2"
            android:excludeFromRecents="true"
            android:process=":runtime2"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".RuntimeThirdActivity" android:exported="false"
            android:taskAffinity="${applicationId}.runtime3"
            android:excludeFromRecents="true"
            android:process=":runtime3"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".RuntimeFourthActivity" android:exported="false"
            android:taskAffinity="${applicationId}.runtime4"
            android:excludeFromRecents="true"
            android:process=":runtime4"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".RuntimeFifthActivity" android:exported="false"
            android:taskAffinity="${applicationId}.runtime5"
            android:excludeFromRecents="true"
            android:process=":runtime5"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <service android:name=".BackgroundGameService"
            android:exported="false"
            android:process=":runtime"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the active J2ME game runtime available while the user switches apps."/>
        </service>
        <service android:name=".BackgroundGameService2"
            android:exported="false"
            android:process=":runtime2"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a second active J2ME game runtime available while the user switches apps."/>
        </service>
        <service android:name=".BackgroundGameService3"
            android:exported="false"
            android:process=":runtime3"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a third active J2ME game runtime available while the user switches apps."/>
        </service>
        <service android:name=".BackgroundGameService4"
            android:exported="false"
            android:process=":runtime4"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a fourth active J2ME game runtime available while the user switches apps."/>
        </service>
        <service android:name=".BackgroundGameService5"
            android:exported="false"
            android:process=":runtime5"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a fifth active J2ME game runtime available while the user switches apps."/>
        </service>
        <activity android:name=".GameSettingsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".KeyMappingActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".GamepadEditorActivity" android:exported="false"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".GameFileManagerActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
    </application>
</manifest>
